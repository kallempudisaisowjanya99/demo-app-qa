# Copy this file to e2e/.env and fill in the values. e2e/.env is gitignored: never commit real credentials.
UI_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8090

# Seeded demo users: the accounts and passwords are listed in the project README, section "Test Users".
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<admin password>
CLAIMANT_EMAIL=<claimant email>
CLAIMANT_PASSWORD=<claimant password>
